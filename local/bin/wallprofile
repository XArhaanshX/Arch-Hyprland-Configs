#!/usr/bin/env bash
# wallprofile — apply a look profile based on which wallpaper is active.
#
#   wallprofile            apply the profile matching the current wallpaper
#   wallprofile <name>     force a named profile (frost | default)
#   wallprofile --list     show profiles and which wallpapers map to them
#   wallprofile --show     show the current wallpaper and which profile matches
#
# Wired to run automatically on wallpaper change via the systemd user units
# wallprofile.path / wallprofile.service, which watch the shell's generated
# wallpaper path file. See ~/README.md.
#
# Profiles are applied through:
#   - ~/.config/hypr/custom/wallprofile.lua  (Hyprland blur/window rules, then reload)
#   - ~/.config/illogical-impulse/config.json (quickshell panel transparency, hot-reloads)
#   - ~/.config/kitty/kitty.conf             (terminal opacity, SIGUSR1 to reload)

set -euo pipefail

# Apps that get a Hyprland opacity rule. Deliberately NOT kitty/foot/Alacritty
# -- those set their own background_opacity, and stacking a window rule on top
# would also fade their text. This list is for apps with no such setting of
# their own (Qt and Electron), where the compositor is the only lever.
GLASS_CLASSES="org.kde.dolphin|Spotify"

# Text-heavy apps get their own, gentler opacity. An editor is read for hours
# at a time, and at the media-app value its body text starts fighting whatever
# is behind it -- especially in the "default" profile, where blur is off and
# the wallpaper shows through sharply rather than diffused.
TEXT_GLASS_CLASSES="code"

STATE_WALL="$HOME/.local/state/quickshell/user/generated/wallpaper/path.txt"
HYPR_PROFILE="$HOME/.config/hypr/custom/wallprofile.lua"
II_CONFIG="$HOME/.config/illogical-impulse/config.json"
KITTY_CONF="$HOME/.config/kitty/kitty.conf"

# ── Profile matching ──────────────────────────────────────────────────────
# Add a line here to map a wallpaper filename pattern to a profile.
# First match wins; anything unmatched falls through to "default".
match_profile() {
    case "${1,,}" in
        *wallpaperflare*|*forest*|*mist*|*fog*|*snow*) echo "frost" ;;
        *)                                            echo "default" ;;
    esac
}

current_wallpaper() {
    [[ -r "$STATE_WALL" ]] && tr -d '\n' < "$STATE_WALL" || echo ""
}

# ── Profile definitions ───────────────────────────────────────────────────
# Each sets: BLUR_SIZE BLUR_PASSES BLUR_VIBRANCY BLUR_BRIGHTNESS BLUR_NOISE
#            WINDOW_BLUR (0/1)  PANEL_TRANSPARENCY  KITTY_OPACITY
#            GLASS_OPACITY (dolphin & friends; blur alone does nothing on an
#            opaque window, so these apps need an opacity rule as well)
load_profile() {
    case "$1" in
        frost)
            BLUR_SIZE=14;  BLUR_PASSES=4
            BLUR_VIBRANCY=0.25; BLUR_BRIGHTNESS=1.05; BLUR_NOISE=0.02
            WINDOW_BLUR=1
            PANEL_TRANSPARENCY=0.45
            KITTY_OPACITY=0.62
            # Frosted: heavy blur behind a fairly sheer window. Slightly more
            # opaque than kitty because Dolphin has far more small text.
            GLASS_OPACITY=0.70
            # User asked for a fully see-through editor (2026-10-04); was 0.85.
            TEXT_GLASS_OPACITY=0.70
            ;;
        default)
            BLUR_SIZE=6;   BLUR_PASSES=2
            BLUR_VIBRANCY=0.5;  BLUR_BRIGHTNESS=1;    BLUR_NOISE=0.05
            WINDOW_BLUR=0
            PANEL_TRANSPARENCY=0.35
            KITTY_OPACITY=0.80
            # Clear glass: no blur, so the wallpaper reads straight through,
            # matching kitty's opacity in this profile.
            GLASS_OPACITY=0.85
            # Unblurred wallpaper behind code is the worst case for legibility,
            # so this is the most conservative value of the lot.
            TEXT_GLASS_OPACITY=0.92
            ;;
        *)
            echo "wallprofile: unknown profile '$1'" >&2; exit 1 ;;
    esac
}

apply_hyprland() {
    mkdir -p "$(dirname "$HYPR_PROFILE")"
    {
        echo "-- Generated by wallprofile. Do not edit; your changes will be overwritten."
        echo "-- Profile: $PROFILE"
        echo "hl.config({"
        echo "    decoration = {"
        echo "        blur = {"
        echo "            size = $BLUR_SIZE,"
        echo "            passes = $BLUR_PASSES,"
        echo "            vibrancy = $BLUR_VIBRANCY,"
        echo "            brightness = $BLUR_BRIGHTNESS,"
        echo "            noise = $BLUR_NOISE"
        echo "        }"
        echo "    }"
        echo "})"
        if [[ $WINDOW_BLUR -eq 1 ]]; then
            # rules.lua blanket-disables blur on every window; re-enable it for
            # the apps where frosted glass actually reads well. Declared after
            # that rule, so this wins.
            echo 'hl.window_rule({match = {class = "^(kitty|foot|Alacritty|org.kde.dolphin|Spotify|code|zen)$"}, no_blur = false})'
        fi
        # Opacity is what actually makes these windows glassy. Hyprland's blur
        # only renders behind translucent pixels, so without this the blur rule
        # above is a no-op on an opaque Qt app like Dolphin.
        echo "hl.window_rule({match = {class = \"^($GLASS_CLASSES)\$\"}, opacity = $GLASS_OPACITY})"
        echo "hl.window_rule({match = {class = \"^($TEXT_GLASS_CLASSES)\$\"}, opacity = $TEXT_GLASS_OPACITY})"
    } > "$HYPR_PROFILE"
    hyprctl reload >/dev/null 2>&1 || true
}

apply_panels() {
    python3 - "$II_CONFIG" "$PANEL_TRANSPARENCY" <<'PY'
import json, sys
path, val = sys.argv[1], float(sys.argv[2])
d = json.load(open(path))
t = d.setdefault('appearance', {}).setdefault('transparency', {})
if t.get('backgroundTransparency') != val:
    t['automatic'] = False
    t['backgroundTransparency'] = val
    json.dump(d, open(path, 'w'), indent=2)
PY
}

apply_kitty() {
    [[ -f "$KITTY_CONF" ]] || return 0
    sed -i -E "s/^background_opacity .*/background_opacity $KITTY_OPACITY/" "$KITTY_CONF"
    pgrep -x kitty >/dev/null 2>&1 && pkill -SIGUSR1 -x kitty || true
}

# ── Entry ─────────────────────────────────────────────────────────────────
WALL="$(current_wallpaper)"

case "${1:-}" in
    --list)
        echo "profiles: frost, default"
        echo "frost matches:  *wallpaperflare* *forest* *mist* *fog* *snow*"
        echo "default:        everything else"
        exit 0 ;;
    --show)
        echo "wallpaper: ${WALL:-<none>}"
        echo "profile:   $(match_profile "$(basename "${WALL:-}")")"
        exit 0 ;;
    -h|--help)
        sed -n '2,9p' "$0" | sed 's/^# \?//'; exit 0 ;;
    "")
        PROFILE="$(match_profile "$(basename "$WALL")")" ;;
    *)
        PROFILE="$1" ;;
esac

load_profile "$PROFILE"
apply_hyprland
apply_panels
apply_kitty
echo "wallprofile: applied '$PROFILE'${WALL:+ for $(basename "$WALL")}"
