# Aesthetic / QoL shell integration.
# Every block is guarded, so this file is inert for tools that aren't installed
# yet — installing them later is enough to light them up.

status is-interactive; or exit 0

# ── zoxide: smarter cd, keeps `cd` muscle memory ───────────────────────
if command -q zoxide
    zoxide init fish --cmd cd | source
end

# ── fzf: key bindings (ctrl-t files, ctrl-r history, alt-c cd) ─────────
# Colours come from conf.d/fzf-matugen.fish, generated by matugen.
if command -q fzf
    fzf --fish | source
end

# ── yazi: `y` exits into whatever directory you browsed to ────────────
if command -q yazi
    function y --description 'yazi, and cd to where you left off'
        set -l tmp (mktemp -t yazi-cwd.XXXXXX)
        yazi $argv --cwd-file="$tmp"
        if set -l cwd (command cat -- "$tmp"); and test -n "$cwd"; and test "$cwd" != "$PWD"
            builtin cd -- "$cwd"
        end
        command rm -f -- "$tmp"
    end
end

# ── eza: richer listings (base `ls` alias lives in config.fish) ────────
if command -q eza; and test "$TERM" != linux
    alias ll 'eza --icons=auto --long --group-directories-first --git'
    alias la 'eza --icons=auto --long --all --group-directories-first --git'
    alias lt 'eza --icons=auto --tree --level=2 --group-directories-first'
    alias ltt 'eza --icons=auto --tree --level=3 --group-directories-first'
end

# ── bat / lazygit shorthands ──────────────────────────────────────────
if command -q bat
    alias b bat
    # Colourised man pages, themed by the matugen bat theme.
    set -gx MANPAGER "sh -c 'col -bx | bat -l man -p'"
    set -gx MANROFFOPT "-c"
end

if command -q lazygit
    alias lg lazygit
end

# ── fastfetch with the live wallpaper as the logo ─────────────────────
if command -q fastfetch
    function ffi --description 'fastfetch, using the current wallpaper as the logo'
        set -l wall (command cat ~/.local/state/quickshell/user/generated/wallpaper/path.txt 2>/dev/null)
        if test -n "$wall"; and test -f "$wall"
            fastfetch --logo-type kitty-direct --logo "$wall" \
                --logo-width 32 --logo-height 16 --logo-padding-top 1
        else
            fastfetch
        end
    end
end

# ── the rotating donut ────────────────────────────────────────────────
# `donut`        spins it full-screen (Ctrl-C to stop)
# `ffdonut`      spins it next to live fastfetch output (Ctrl-C to stop)
# `fastfetch`    static frame, since fastfetch renders once and exits
#
# `ffreroll` re-renders the static logo at a random angle, so plain
# `fastfetch` shows a different orientation next time.
if command -q donut
    function ffdonut --description 'spinning donut beside fastfetch output'
        donut --fetch $argv
    end

    function ffreroll --description 're-render the static fastfetch donut logo'
        donut --frame --trim --random --cols 42 --rows 22 \
            > $HOME/.config/fastfetch/donut.txt
        and echo "fastfetch donut logo re-rolled"
    end
end

# ── bluetooth: scan showing only devices with real names ──────────────
# Nearby phones/watches advertise BLE with rotating random addresses and no
# name; they show up as bare MACs and bury anything pairable.
if command -q bluetoothctl
    function btscan --description 'scan for bluetooth devices that have a name'
        set -l secs (test -n "$argv[1]"; and echo $argv[1]; or echo 15)
        echo "scanning $secs""s — put the device in pairing mode now…"
        bluetoothctl --timeout $secs scan on 2>/dev/null \
            | grep -aoE "Device [0-9A-F:]{17} .*" \
            | sed 's/^Device //' \
            | grep -avE "ManufacturerData|RSSI|TxPower|ServiceData|UUID|Connected|Paired|Bonded|LegacyPairing|ServicesResolved" \
            | grep -avE '([0-9A-F]{2}:){5}[0-9A-F]{2} ([0-9A-F]{2}-){5}[0-9A-F]{2}$' \
            | sort -u
    end
end

# ── make plain `fastfetch` spin ───────────────────────────────────────
# fastfetch itself renders once and exits, so it can never animate. This
# wrapper sends interactive, terminal-attached calls to `donut --fetch`
# instead, which keeps redrawing the torus beside fastfetch's real output.
#
# Escape hatches: `command fastfetch` always runs the real binary, and so
# does any non-tty use (pipes, redirects, scripts), so nothing that parses
# fastfetch output breaks. Delete this block to undo.
if command -q donut; and command -q fastfetch
    function fastfetch --description 'fastfetch, with the donut spinning'
        if isatty stdout; and not set -q FASTFETCH_STATIC
            donut --fetch $argv
        else
            command fastfetch $argv
        end
    end
end
