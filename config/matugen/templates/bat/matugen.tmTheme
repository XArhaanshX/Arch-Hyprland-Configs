<?xml version="1.0" encoding="UTF-8"?>
<!-- Material You syntax theme for bat, generated by matugen.
     Edit ~/.config/matugen/templates/bat/matugen.tmTheme, not this file. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>matugen</string>
	<key>settings</key>
	<array>
		<dict>
			<key>settings</key>
			<dict>
				<key>background</key>
				<string>{{colors.surface.default.hex}}</string>
				<key>caret</key>
				<string>{{colors.primary.default.hex}}</string>
				<key>foreground</key>
				<string>{{colors.on_surface.default.hex}}</string>
				<key>invisibles</key>
				<string>{{colors.outline_variant.default.hex}}</string>
				<key>lineHighlight</key>
				<string>{{colors.surface_container_high.default.hex}}</string>
				<key>selection</key>
				<string>{{colors.primary_container.default.hex}}</string>
				<key>gutterForeground</key>
				<string>{{colors.outline.default.hex}}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key><string>Comment</string>
			<key>scope</key><string>comment, punctuation.definition.comment</string>
			<key>settings</key><dict>
				<key>fontStyle</key><string>italic</string>
				<key>foreground</key><string>{{colors.outline.default.hex}}</string>
			</dict>
		</dict>
		<dict>
			<key>name</key><string>String</string>
			<key>scope</key><string>string, string.quoted, constant.character</string>
			<key>settings</key><dict><key>foreground</key><string>{{colors.tertiary.default.hex}}</string></dict>
		</dict>
		<dict>
			<key>name</key><string>Number / Constant</string>
			<key>scope</key><string>constant.numeric, constant.language, constant.other</string>
			<key>settings</key><dict><key>foreground</key><string>{{colors.tertiary_fixed_dim.default.hex}}</string></dict>
		</dict>
		<dict>
			<key>name</key><string>Keyword</string>
			<key>scope</key><string>keyword, keyword.control, storage.type, storage.modifier</string>
			<key>settings</key><dict><key>foreground</key><string>{{colors.primary.default.hex}}</string></dict>
		</dict>
		<dict>
			<key>name</key><string>Operator</string>
			<key>scope</key><string>keyword.operator, punctuation.separator, punctuation.terminator</string>
			<key>settings</key><dict><key>foreground</key><string>{{colors.on_surface_variant.default.hex}}</string></dict>
		</dict>
		<dict>
			<key>name</key><string>Function</string>
			<key>scope</key><string>entity.name.function, support.function, meta.function-call</string>
			<key>settings</key><dict><key>foreground</key><string>{{colors.secondary.default.hex}}</string></dict>
		</dict>
		<dict>
			<key>name</key><string>Type / Class</string>
			<key>scope</key><string>entity.name.type, entity.name.class, support.type, support.class</string>
			<key>settings</key><dict><key>foreground</key><string>{{colors.primary_fixed_dim.default.hex}}</string></dict>
		</dict>
		<dict>
			<key>name</key><string>Variable</string>
			<key>scope</key><string>variable, variable.parameter, variable.other</string>
			<key>settings</key><dict><key>foreground</key><string>{{colors.on_surface.default.hex}}</string></dict>
		</dict>
		<dict>
			<key>name</key><string>Tag</string>
			<key>scope</key><string>entity.name.tag</string>
			<key>settings</key><dict><key>foreground</key><string>{{colors.primary.default.hex}}</string></dict>
		</dict>
		<dict>
			<key>name</key><string>Attribute</string>
			<key>scope</key><string>entity.other.attribute-name</string>
			<key>settings</key><dict><key>foreground</key><string>{{colors.secondary_fixed_dim.default.hex}}</string></dict>
		</dict>
		<dict>
			<key>name</key><string>Invalid</string>
			<key>scope</key><string>invalid, invalid.illegal</string>
			<key>settings</key><dict><key>foreground</key><string>{{colors.error.default.hex}}</string></dict>
		</dict>
		<dict>
			<key>name</key><string>Diff inserted</string>
			<key>scope</key><string>markup.inserted</string>
			<key>settings</key><dict><key>foreground</key><string>{{colors.tertiary.default.hex}}</string></dict>
		</dict>
		<dict>
			<key>name</key><string>Diff deleted</string>
			<key>scope</key><string>markup.deleted</string>
			<key>settings</key><dict><key>foreground</key><string>{{colors.error.default.hex}}</string></dict>
		</dict>
		<dict>
			<key>name</key><string>Markup heading</string>
			<key>scope</key><string>markup.heading, entity.name.section</string>
			<key>settings</key><dict>
				<key>fontStyle</key><string>bold</string>
				<key>foreground</key><string>{{colors.primary.default.hex}}</string>
			</dict>
		</dict>
	</array>
	<key>uuid</key>
	<string>7b3c1f2e-9a4d-4e21-8c55-matugenmatug</string>
</dict>
</plist>
