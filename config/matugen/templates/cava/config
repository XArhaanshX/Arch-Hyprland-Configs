## Material You cava config, generated by matugen.
## Edit ~/.config/matugen/templates/cava/config, not this file.

[general]
framerate = 60
autosens = 1
overshoot = 20
bar_width = 2
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average
alacritty_sync = 0

[color]
gradient = 1
gradient_count = 6
gradient_color_1 = '{{colors.primary_container.default.hex}}'
gradient_color_2 = '{{colors.primary.default.hex}}'
gradient_color_3 = '{{colors.secondary.default.hex}}'
gradient_color_4 = '{{colors.tertiary.default.hex}}'
gradient_color_5 = '{{colors.tertiary_fixed_dim.default.hex}}'
gradient_color_6 = '{{colors.on_surface.default.hex}}'

[smoothing]
noise_reduction = 35

[eq]
1 = 1
2 = 1
3 = 1
4 = 1
5 = 1
