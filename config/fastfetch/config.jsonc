// fastfetch — Material You, with the donut.c torus as the logo.
//
// Colours use palette slots 243/245/251/253, which the illogical-impulse dots
// remap to the wallpaper's Material palette, so this follows the wallpaper
// automatically with no regeneration.
//
// The logo is ~/.config/fastfetch/donut.txt, rendered by `donut --frame`.
// Type is "file-raw" so its own ANSI colours survive; "file" would strip them
// and repaint with fastfetch's logo colour instead.
//
// All key icons are from the nf-md-* range (U+F0000+). Mixing in BMP icons
// (U+E000-U+F8FF) breaks column alignment: fastfetch measures the two ranges
// as different display widths.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "file-raw",
    "source": "~/.config/fastfetch/donut.txt",
    "padding": { "top": 2, "left": 2, "right": 4 }
  },

  "display": {
    "separator": "   ",
    "color": { "keys": "38;5;243", "title": "38;5;243" },
    "key": { "width": 2 },
    "constants": [
      "────────────────────────────────────"
    ]
  },

  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#38;5;243}{user-name}{#38;5;245} on {#38;5;251}{host-name}"
    },
    { "type": "custom", "format": "{#38;5;245}{$1}" },

    { "type": "os",       "key": "󰌽", "keyColor": "38;5;243" },
    { "type": "kernel",   "key": "󰘚", "keyColor": "38;5;243", "format": "{release}" },
    { "type": "uptime",   "key": "󰅐", "keyColor": "38;5;243" },
    { "type": "packages", "key": "󰏖", "keyColor": "38;5;243" },
    { "type": "shell",    "key": "󰆍", "keyColor": "38;5;243" },

    { "type": "custom", "format": "{#38;5;245}{$1}" },

    { "type": "wm",       "key": "󰕰", "keyColor": "38;5;251" },
    { "type": "terminal", "key": "󰞷", "keyColor": "38;5;251" },
    { "type": "display",  "key": "󰍹", "keyColor": "38;5;251", "compactType": "original-with-refresh-rate" },
    { "type": "theme",    "key": "󰉼", "keyColor": "38;5;251" },

    { "type": "custom", "format": "{#38;5;245}{$1}" },

    { "type": "cpu",     "key": "󰻠", "keyColor": "38;5;253" },
    { "type": "gpu",     "key": "󰢮", "keyColor": "38;5;253" },
    { "type": "memory",  "key": "󰾆", "keyColor": "38;5;253" },
    { "type": "disk",    "key": "󰋊", "keyColor": "38;5;253", "folders": "/" },
    { "type": "battery", "key": "󰂄", "keyColor": "38;5;253" },

    { "type": "custom", "format": "{#38;5;245}{$1}" },

    { "type": "colors", "symbol": "circle", "paddingLeft": 1 },
    "break"
  ]
}
