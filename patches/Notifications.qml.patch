+    // Expose do-not-disturb over IPC so scripts can reach it (the quick
+    // toggle in the sidebar is otherwise the only way to set it).
+    //   qs -c ii ipc call notifications silence
+    //   qs -c ii ipc call notifications unsilence
+    IpcHandler {
+        target: "notifications"
+
+        function silence(): void {
+            root.silent = true;
+        }
+
+        function unsilence(): void {
+            root.silent = false;
+        }
+
+        function toggleSilence(): void {
+            root.silent = !root.silent;
+        }
+
+        function isSilent(): string {
